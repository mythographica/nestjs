{
	"name": "@mnemonica/nestjs",
	"version": "0.2.0",
	"description": "NestJS adapter for mnemonica — data lineage, nominal typing, and hook-based observability",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"files": [
		"build/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build && npm test"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@mnemonica/dive": "^0.3.0",
		"@nestjs/common": "^10.0.0 || ^11.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0",
		"@opentelemetry/api": "^1.0.0",
		"class-transformer": "^0.5.0",
		"class-validator": "^0.14.0",
		"mnemonica": ">=1.2.2",
		"reflect-metadata": "^0.2.0"
	},
	"devDependencies": {
		"@mnemonica/dive": "^0.3.5",
		"@nestjs/common": "^10.4.0",
		"@nestjs/core": "^10.4.0",
		"@nestjs/testing": "^10.4.22",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/sdk-trace-node": "^1.26.0",
		"@types/express": "^5.0.6",
		"@types/node": "^20.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"mnemonica": "^1.2.5",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.0",
		"typescript": "^5.5.0",
		"vitest": "^2.0.0"
	},
	"keywords": [
		"mnemonica",
		"nestjs",
		"inheritance",
		"prototype",
		"tracing",
		"opentelemetry",
		"validation",
		"dependency-injection"
	],
	"author": "went.out@gmail.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythographica/nestjs.git"
	},
	"bugs": {
		"url": "https://github.com/mythographica/nestjs/issues"
	},
	"homepage": "https://github.com/mythographica/nestjs#readme"
}
